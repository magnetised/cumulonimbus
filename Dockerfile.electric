ARG ELIXIR_VERSION=1.18.1
ARG OTP_VERSION=27.2
ARG DEBIAN_VERSION=bookworm-20241223-slim

ARG BUILDER_IMAGE="hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION}"
ARG RUNNER_IMAGE="debian:${DEBIAN_VERSION}"

FROM ${BUILDER_IMAGE} AS builder
LABEL maintainer="info@electric-sql.com"

RUN apt-get update -y && \
  apt-get install -y build-essential git curl && \
  apt-get clean && \
  rm -f /var/lib/apt/lists/*_*

RUN mix local.hex --force && mix local.rebar --force

ARG MIX_ENV=prod
ARG ELECTRIC_VERSION

WORKDIR /app

COPY mix.* /app/
RUN mix deps.get
RUN mix deps.compile

# These are ordered by change frequency, with the least frequently changing dir first.
COPY rel /app/rel
COPY lib /app/lib/

COPY package.json /app/
COPY config/*.exs /app/config/


RUN mix compile
RUN mix release

RUN ls -l /app/_build

FROM ${RUNNER_IMAGE} AS runner_setup

ARG USE_JEMALLOC=false

RUN apt-get update -y && \
  apt-get install -y libstdc++6 openssl libncurses5 locales ca-certificates curl \
    $([ "$USE_JEMALLOC" = "true" ] && echo "libjemalloc2") && \
  apt-get clean && \
  rm -f /var/lib/apt/lists/*_*

# Set the locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

ENV LANG=en_US.UTF-8 \
  LANGUAGE=en_US:en \
  LC_ALL=en_US.UTF-8 \
  MIX_ENV=prod

WORKDIR "/app"

RUN chown nobody /app

FROM runner_setup AS runner

ARG RELEASE_NAME=electric
ARG USE_JEMALLOC=false

# When USE_JEMALLOC=true, preload jemalloc so all malloc/free calls from the
# BEAM's erts_alloc go through jemalloc instead of glibc's allocator.
# Docker ENV treats the string "false" as non-empty, so we can't use
# ${VAR:+value} syntax. Instead, create a wrapper script that conditionally
# sets LD_PRELOAD before exec'ing the release.
RUN if [ "$USE_JEMALLOC" = "true" ]; then \
      echo "JEMALLOC=true" > /app/.allocator; \
    else \
      echo "JEMALLOC=false" > /app/.allocator; \
    fi

COPY --from=builder "/app/_build/prod/rel/${RELEASE_NAME}" ./

RUN mv /app/bin/${RELEASE_NAME} /app/bin/release

# Wrapper entrypoint that conditionally sets LD_PRELOAD
RUN printf '#!/bin/sh\n\
if [ "$(cat /app/.allocator)" = "JEMALLOC=true" ]; then\n\
  export LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2\n\
fi\n\
exec /app/bin/release "$@"\n' > /app/bin/entrypoint && chmod +x /app/bin/entrypoint

HEALTHCHECK --start-period=10s CMD curl --fail http://localhost:${ELECTRIC_PORT-3000}/v1/health || exit 1

ENTRYPOINT ["/app/bin/entrypoint"]

CMD ["start"]

